# Copy to .env and fill in real values. Never commit the real .env file.

APP_NAME=KeyMood AI Backend
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database ---
POSTGRES_USER=keymood
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=keymood

# --- Redis (rate limiting only for MVP) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT (RS256) ---
# Dev: point at local PEM files (see keys/ — generate your own, do not
# reuse any keypair from a template/example repo in production).
# Prod: these same two env vars are populated by the platform's secrets
# manager — no code change between environments.
JWT_PRIVATE_KEY_PATH=./keys/dev_jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/dev_jwt_public.pem
JWT_ISSUER=keymood-ai
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- Password policy ---
PASSWORD_MIN_LENGTH=10

# --- Google OAuth ---
GOOGLE_CLIENT_ID=

# --- Dev convenience ---
# true = new accounts are auto-verified and no verification email is sent, so
# the app works without an SMTP server. Only honoured when APP_ENV=development.
DEV_AUTO_VERIFY_EMAIL=true

# --- Frontend (for email links) ---
FRONTEND_BASE_URL=http://localhost:5173

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Logging ---
LOG_LEVEL=INFO

# --- SMTP (dev: point at a local mailhog/mailpit instance) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_ADDRESS=no-reply@keymood.ai
